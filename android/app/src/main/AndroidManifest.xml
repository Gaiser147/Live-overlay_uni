<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="false"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar"
        android:usesCleartextTraffic="false">

        <!-- Overlay: WebView mit der Tablet-App, Ton kommt vom Bedienungshilfe-Dienst. -->
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:exported="true"
            android:resizeableActivity="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Phase 0: Mikrofon-Spike. Zeigt Pegel und ob Android die Aufnahme stumm schaltet. -->
        <activity
            android:name=".SpikeActivity"
            android:exported="true"
            android:label="@string/spike_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Weg 1 (CDD 5.4.5): Ein Bedienungshilfe-Dienst, der mit VOICE_RECOGNITION aufnimmt,
             darf gleichzeitig mit einer weiteren App (TwinMind) aufnehmen. Er wertet keine
             Bildschirm-Ereignisse aus. -->
        <service
            android:name=".AudioCaptureService"
            android:exported="false"
            android:label="@string/service_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>
    </application>
</manifest>
